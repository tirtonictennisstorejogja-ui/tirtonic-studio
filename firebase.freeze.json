{
  "firestore": {
    "rules": "firestore.freeze.rules"
  },
  "hosting": {
    "public": "website",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}