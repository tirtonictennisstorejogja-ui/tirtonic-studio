rules_version = '2';

// Aturan keamanan Media Desk.
// LANGKAH WAJIB: ganti dua email di ownerEmails() dengan email Google admin (huruf kecil semua),
// sama persis dengan adminEmails di config.js. Admin lain bisa ditambahkan dari menu Tim & Aktivitas.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmails() {
      return ['mzakiramadhan261003@gmail.com'];
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isOwner() { return signedIn() && myEmail() in ownerEmails(); }
    function hasMemberDoc() { return signedIn() && exists(memberPath()); }
    function isMember() { return isOwner() || hasMemberDoc(); }
    function isAdmin() { return isOwner() || (hasMemberDoc() && get(memberPath()).data.role == 'admin'); }
    // Anggota yang dicentang "Boleh memakai Analisis IDCC" (misalnya Aulia)
    // Admin 2 (peran 'admin2'): mengelola barang, konten, dan pengaturan seperti admin, tetapi tidak akun tim dan laporan
    function isStaff() { return isAdmin() || (hasMemberDoc() && get(memberPath()).data.role == 'admin2'); }
    function isIdcc() { return isStaff() || (hasMemberDoc() && get(memberPath()).data.get('idcc', false) == true); }

    // Akun tim: setiap orang bisa membaca akunnya sendiri, hanya admin yang mengelola
    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      allow write: if isAdmin();
      // Setiap orang boleh mengganti tampilan profilnya sendiri (warna, avatar hewan, foto kecil), tidak ada isian lain
      allow update: if signedIn() && email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avColor', 'avAnimal', 'avPhoto'])
        && request.resource.data.get('avColor', 'lime') in ['lime', 'orange', 'purple', 'teal', 'green', 'pink']
        && request.resource.data.get('avAnimal', '') in ['', 'cat', 'dog', 'panda', 'fox', 'rabbit', 'koala', 'tiger', 'frog', 'penguin', 'monkey', 'bear', 'chick']
        && request.resource.data.get('avPhoto', '') is string && request.resource.data.get('avPhoto', '').size() <= 60000;
    }

    // Kalender pribadi: hanya pemiliknya sendiri yang bisa membaca dan mengubah (admin pun tidak)
    match /pcal/{email} {
      allow read: if signedIn() && email == myEmail() && isMember();
      allow create, update: if signedIn() && email == myEmail() && isMember()
        && request.resource.data.keys().hasOnly(['color', 'notes', 'updatedAt'])
        && request.resource.data.get('color', 'lime') in ['lime', 'orange', 'purple', 'teal', 'green', 'pink']
        && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 5000;
      match /events/{id} {
        allow read, delete: if signedIn() && email == myEmail() && isMember();
        allow create, update: if signedIn() && email == myEmail() && isMember()
          && request.resource.data.keys().hasOnly(['date', 'title', 'time', 'color', 'note', 'updatedAt'])
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
          && request.resource.data.get('time', '') is string && request.resource.data.get('time', '').size() <= 5
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500
          && request.resource.data.color in ['lime', 'orange', 'purple', 'teal', 'green', 'pink'];
      }
    }

    match /items/{id} {
      allow read: if isMember();
      allow write: if isStaff();
      // anggota IDCC hanya boleh MENAMBAH barang stok lama dari hasil analisis, tidak mengubah barang yang ada
      allow create: if isIdcc() && request.resource.data.get('old', false) == true;
    }
    // Gambar latar halaman login: dibaca sebelum login, diubah admin
    match /public/{id}   { allow read: if true; allow write: if isAdmin(); }
    // Riwayat Analisis IDCC
    match /idcc/{id}     { allow read, create: if isIdcc(); allow update, delete: if isStaff(); }
    // Foto barang (ukuran besar). Thumbnail tersimpan di data barang.
    match /photos/{id}   { allow read: if isMember(); allow write: if isStaff(); }
    match /settings/{id} { allow read: if isMember(); allow write: if isStaff(); }
    match /logs/{id}     { allow read: if isMember(); allow write: if isStaff(); }
    match /locks/{id}    { allow read, write: if isStaff(); }
    // Laporan mingguan, planning, dan bulanan: khusus admin
    match /reports/{id}  { allow read, write: if isAdmin(); }

    match /tasks/{id} {
      // semua anggota boleh membaca (untuk kalender tim); aplikasi hanya menampilkan tugas miliknya di pipeline
      allow read: if isMember();
      allow create: if isStaff() || idccCreate();
      allow delete: if isStaff();
      allow update: if isStaff() || memberStatusUpdate();

      // Anggota IDCC: hanya membuat konten IDCC baru dari stok lama, status awal Rencana
      function idccCreate() {
        let d = request.resource.data;
        return isIdcc()
          && d.get('source', '') == 'lama'
          && d.get('reason', '') == 'idcc'
          && d.get('type', '') in ['idc', 'idf']
          && d.get('status', '') in ['Rencana', 'Terdata'];
      }

      // Anggota: hanya tugas tempat ia menjadi produser / editor / talent / penulis skrip,
      // hanya status (Terdata s.d. Ready), catatan, link file final, dan riwayat yang boleh berubah.
      function memberStatusUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let early = ['Rencana', 'Siap Produksi', 'Diproduksi', 'Editing', 'QC', 'Terdata', 'Ready'];
        let allowedTo = ['Terdata', 'Diproduksi', 'Editing', 'Ready'];
        let code = get(memberPath()).data.get('code', '');
        return hasMemberDoc()
          && code is string && code != ''
          && code in [before.get('producer', ''), before.get('editor', ''), before.get('talent', ''), before.get('script', '')]
          && after.diff(before).affectedKeys().hasOnly(['status', 'shotAt', 'readyAt', 'note', 'driveUrl', 'history', 'updatedAt', 'updatedBy'])
          && before.status in early
          && before.get('metaAt', 0) == 0
          && (after.status in allowedTo || after.status == before.status)
          && after.get('note', '') is string && after.get('note', '').size() <= 1000
          && after.get('driveUrl', '') is string && after.get('driveUrl', '').size() <= 500
          && after.get('history', []) is list && after.get('history', []).size() <= 40;
      }
    }
  }
}
